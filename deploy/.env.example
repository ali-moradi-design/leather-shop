# Copy to .env on the server (never commit the real one). Generate secrets with:
#   openssl rand -base64 48
# commit SHA of the images to run (CI sets this on every deploy)
IMAGE_TAG=
MONGO_ROOT_USER=leather
MONGO_ROOT_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REVALIDATE_SECRET=
# admin sign-in for the live demo (12+ characters, keep private)
ADMIN_EMAIL=admin@weltandgrain.local
ADMIN_PASSWORD=
